;
;  書き換え厳禁
;
; DO NOT REWRITE
;
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Info]
name         = "l_suwako-sama"				; 内部名称
displayname  = "Z v vv 4 |< () $ /\ AA /\"	; 表示名称
author       = "Halkaze"					; 制作者名
pal.defaults = 1							; サバイバルで出現するカラー

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[Files]
cns      = _suwako-sama.def		; cns定義ファイル
cmd      = _suwako-sama.def		; cmd定義ファイル
st       = Sys/000.cns			; st定義ファイル０（-1, -2, -3, -4, -5, -6, -7, -8）
st0      = Sys/001.cns			; st定義ファイル１（-9）st1      = Sys/002.cns			; st定義ファイル２（-10,-11,-12,-13,-14,-15）
stcommon = 						; common定義ファイル
sprite   = Res/suwako.sff		; sprite定義ファイル
anim     = _suwako-sama.def		; anim定義ファイル
pal1     = 

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[Data]
life=1000
power=3000
attack=100
defence=100
fall.defence_up=100
liedown.time=0
airjuggle=15
sparkno=-1
guard.sparkno=-1
KO.echo=0
volume=255
IntPersistIndex=60
FloatPersistIndex=40
[Size]
xscale=1
yscale=1
ground.back=1
ground.front=1
air.back=1
air.front=1
height=1
attack.dist=1
proj.attack.dist=1
proj.doscale=0
head.pos=0,0
mid.pos=0,0
shadowoffset=0
draw.offset=0,0
[Velocity]
walk.fwd=0
walk.back=0
run.fwd=0,0
run.back=0,0
jump.neu=0,0
jump.back=0
jump.fwd=0
runjump.back=0,0
runjump.fwd=0,0
airjump.neu=0,0
airjump.back=0
airjump.fwd=0
[Movement]
airjump.num=0
airjump.height=0
yaccel=1
stand.friction=1
crouch.friction=1
[Command]
name="start"
command=s
time=1

